{
    "name": "@macery12/m12labs",
    "version": "4.0.0dev",
    "license": "MIT",
    "private": true,
    "packageManager": "pnpm@10.32.0",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "build": "pnpm --filter ./frontend run build",
        "build:frontend": "pnpm --filter ./frontend run build",
        "postbuild": "bash ./scripts/reload-dev-services.sh",
