{% extends "layout.twig" %}

{% block content %}
    {% include "partials/header.twig" with {
        title: 'Important Announcement',
        subtitle: 'A message from the administration team.'
    } %}
    <p style="margin:0 0 16px; color:#111827; font-size:15px; line-height:1.6;">Hello,</p>
    {% embed "partials/panel.twig" %}
        {% block body %}
            {# nl2br escapes before converting newlines, so this needs no raw filter. #}
            {{ message|nl2br }}
        {% endblock %}
    {% endembed %}
    <p style="margin:0 0 16px; color:#111827; font-size:15px; line-height:1.6;">— {{ adminName }}</p>
{% endblock %}
