{% set tableRows = rows|default({}) %}
{% set tableLabelWidth = labelWidth|default('38%') %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-spacing:0; margin: 4px 0 0;">
    {% for label, value in tableRows %}
        {% if value is not null and value != '' %}
            <tr>
                <td style="padding: 8px 8px 6px 0; width: {{ tableLabelWidth }}; font-weight:700; color:#111827; font-size:14px; line-height:1.4;">{{ label }}</td>
                <td style="padding: 8px 0 6px; color:#111827; font-size:14px; line-height:1.5; word-break: break-word;">{{ value }}</td>
            </tr>
        {% endif %}
    {% endfor %}
</table>
