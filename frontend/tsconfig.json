{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,

        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,

        // Paraglide's generated JS is excluded below. Components use the compact
        // generated MessageFunctions interface instead of making TypeScript parse
        // several megabytes of locale implementation code.
        "allowJs": true,
        "checkJs": false,

        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.cache/m12labs-ui.tsbuildinfo",
        "jsx": "react-jsx",

        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,

        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src", "vite.config.ts"],
    "exclude": ["src/paraglide", "src/i18n/generated/full", "src/i18n/generated/public"]
}
