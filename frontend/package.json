{
    "name": "m12labs-ui-v2",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.32.0",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev": "vite",
        "predev": "node scripts/merge-extension-messages.mjs && node scripts/compile-i18n.mjs",
        "build": "node scripts/merge-extension-messages.mjs && node scripts/compile-i18n.mjs && tsc -b && vite build",
        "build:fast": "vite build",
        "budget": "node scripts/bundle-report.mjs --check",
        "budget:report": "node scripts/bundle-report.mjs",
        "lint": "eslint src tests scripts/lighthouse-baseline-report.mjs playwright.config.ts vite.config.ts vitest.config.ts lighthouse.config.cjs lighthouse.routes.cjs lighthouserc.cjs lighthouserc.mobile.cjs lighthouserc.baseline.cjs",
        "locales:set": "node scripts/locales.mjs",
        "preview": "vite preview",
        "test": "vitest run",
        "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright install chromium",
        "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test",
        "test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers playwright test --ui",
        "test:lighthouse": "pnpm run test:lighthouse:desktop && pnpm run test:lighthouse:mobile",
        "test:lighthouse:desktop": "lhci autorun --config=./lighthouserc.cjs",
        "test:lighthouse:mobile": "lhci autorun --config=./lighthouserc.mobile.cjs",
        "test:lighthouse:baseline": "pnpm run test:lighthouse:baseline:desktop && pnpm run test:lighthouse:baseline:mobile && pnpm run test:lighthouse:baseline:report",
        "test:lighthouse:baseline:desktop": "LIGHTHOUSE_PROFILE=desktop lhci autorun --config=./lighthouserc.baseline.cjs",
        "test:lighthouse:baseline:mobile": "LIGHTHOUSE_PROFILE=mobile lhci autorun --config=./lighthouserc.baseline.cjs",
        "test:lighthouse:baseline:report": "node scripts/lighthouse-baseline-report.mjs"
    },
    "dependencies": {
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.12",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-php": "^6.0.2",
        "@codemirror/lang-python": "^6.2.1",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/lang-xml": "^6.1.0",
        "@codemirror/lang-yaml": "^6.1.3",
        "@codemirror/language": "^6.12.4",
        "@codemirror/legacy-modes": "^6.5.4",
        "@codemirror/state": "^6.7.4",
        "@codemirror/view": "^6.43.11",
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-popover": "^1.1.23",
        "@radix-ui/react-select": "^2.3.7",
        "@stripe/react-stripe-js": "^6.9.0",
        "@stripe/stripe-js": "^9.15.0",
        "@tanstack/react-query": "^5.102.8",
        "@tanstack/react-virtual": "^3.14.10",
        "@uiw/react-codemirror": "^4.25.11",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-web-links": "^0.12.0",
        "@xterm/xterm": "^6.0.0",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.41.0",
        "mitt": "^3.0.1",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.87.0",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.18.3",
        "remark-gfm": "^4.0.1",
        "sockette": "^2.0.6",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.5.4",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@inlang/paraglide-js": "^2.25.0",
        "@lhci/cli": "^0.15.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.12.0",
        "laravel-vite-plugin": "^3.2.0",
        "lighthouse": "^13.4.1",
        "tailwindcss": "^4.3.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.69.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    }
}
